{
  "name": "hdbt_admin",
  "version": "1.1.0",
  "description": "Theme builder configuration for HDBT admin theme",
  "author": "Druid",
  "license": "MIT",
  "repository": "github:City-of-Helsinki/drupal-hdbt-admin",
  "scripts": {
    "dev": "../hdbt/tools/sandbox.sh node theme-builder.mjs --watch --dev",
    "build": "../hdbt/tools/sandbox.sh sh -c 'node theme-builder.mjs'",
    "postinstall": "npm --prefix ../hdbt install --no-audit --progress=false --loglevel=silent",
    "lint:stylelint": "../hdbt/tools/sandbox.sh stylelint \"src/scss/**/*.scss\" --config ../hdbt/theme-builder/.stylelintrc.yaml --fix",
    "lint": "../hdbt/tools/sandbox.sh npm-run-all --parallel lint:scss lint:js -s"
  },
  "@comment dependencies": [
    "Select2 Drupal module uses the development version of select2 library.",
    "See: https://git.drupalcode.org/project/select2/-/compare/8.x-1.x...2.0.0#line_587d266bb_A70",
    {
      "select2": "A commit from develop branch."
    }
  ],
  "dependencies": {
    "@hdbt/theme-builder": "file:../hdbt/theme-builder",
    "css-declaration-sorter": "^7.2.0",
    "eslint": "^8.57.1",
    "glob": "^11.0.0",
    "hds-design-tokens": "^6.0.5",
    "npm-run-all2": "^8.0.4",
    "postcss-cli": "^11.0.1",
    "select2": "git+https://github.com/select2/select2.git#595494a72fee67b0a61c64701cbb72e3121f97b9",
    "stylelint-config-standard-scss": "^15.0.0"
  },
  "allowScripts": {
    "fsevents": false
  }
}
