{
  "name": "hdbt_admin",
  "version": "1.1.0",
  "description": "Theme builder configuration for HDBT admin theme",
  "author": "Druid",
  "license": "MIT",
  "repository": "github:City-of-Helsinki/drupal-hdbt-admin",
  "@comment scripts": [
    "Every build, lint and format script below runs inside a disposable Node container via the sandbox command.",
    "@todo UHF-13820: Add 'npm run lint --loglevel=silent' back to the build script."
  ],
  "scripts": {
    "preinstall": "npm install ../hdbt/theme-builder --loglevel=silent",
    "dev": "sandbox node theme-builder.mjs --watch --dev",
    "build": "sandbox sh -c 'npm run format:js --loglevel=silent && node theme-builder.mjs'",
    "lint:scss": "sandbox stylelint \"src/scss/**/*.scss\" --fix",
    "lint:js": "sandbox biome lint --no-errors-on-unmatched src/js/",
    "format:js": "sandbox biome format --write --no-errors-on-unmatched src/js/",
    "lint": "sandbox npm-run-all --parallel lint:scss lint:js -s"
  },
  "@comment dependencies": [
    "Select2 Drupal module uses the development version of select2 library.",
    "See: https://git.drupalcode.org/project/select2/-/compare/8.x-1.x...2.0.0#line_587d266bb_A70",
    {
      "select2": "A commit from develop branch."
    }
  ],
  "dependencies": {
    "@hdbt/theme-builder": "file:../hdbt/theme-builder",
    "glob": "^11.0.0",
    "npm-run-all2": "^8.0.4",
    "select2": "git+https://github.com/select2/select2.git#595494a72fee67b0a61c64701cbb72e3121f97b9"
  },
  "allowScripts": {
    "fsevents": false,
    "@parcel/watcher": false,
    "esbuild": false
  },
  "engines": {
    "npm": ">=12.0.0",
    "node": ">=24.0.0"
  }
}
